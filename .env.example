# Public site URL (used for share links, Open Graph, SMS templates)
# Example: https://saturday.48training.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Interest form notifications (sent to Ethan by default)
LEAD_NOTIFICATION_EMAIL=thefords526@gmail.com

# Resend (https://resend.com) — required in production for email delivery
RESEND_API_KEY=
# Must be a verified sender in Resend, e.g. Saturday Workout <hello@yourdomain.com>
RESEND_FROM_EMAIL=

# GoHighLevel inbound webhook (optional — leads are always saved locally when storage is writable)
GHL_WEBHOOK_URL=

# Optional shared secret sent as Authorization: Bearer <token> if your GHL workflow expects it
GHL_WEBHOOK_BEARER_TOKEN=

# Interest form rate limit (submissions per IP per window)
INTEREST_RATE_LIMIT_MAX=5
INTEREST_RATE_LIMIT_WINDOW_MS=900000
